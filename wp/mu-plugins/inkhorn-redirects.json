{
 "_note": "Redirects for old inkhorn.press (Ghost) addresses. Rebuilt 2026-11-20 for the layout where every site has its own domain: only addresses that changed AND that something links to or that ever had real content. Rules marked final apply only once inkhorn.press is the live host (WP_DOMAIN=inkhorn.press); the others apply now. Before: 41 rules; after: 21.",
 "rules": [
  {
   "from": "^/support/?$",
   "to": "/donate/"
  },
  {
   "from": "^/preferences/?$",
   "to": "/newsletter/"
  },
  {
   "from": "^/subscribe/?$",
   "to": "/shop/subscriptions/"
  },
  {
   "from": "^/(?:shop/)?print-edition/?$",
   "to": "/shop/subscriptions/"
  },
  {
   "from": "^/(?:shop/)?address/?$",
   "to": "/account/"
  },
  {
   "from": "^/(cart|order-complete)/?$",
   "to": "/shop/$1/"
  },
  {
   "from": "^/(?:print|books)/?$",
   "to": "/shop/"
  },
  {
   "from": "^/patreon-supporters/?$",
   "to": "/donate/"
  },
  {
   "from": "^/submit/review/?$",
   "to": "https://duotrope.com/duosuma/submit/inkhorn-review-iGX4p"
  },
  {
   "from": "^/submit/muse/?$",
   "to": "https://gomuse.io"
  },
  {
   "from": "^/by/([^/]+)/?$",
   "to": "/contributors/$1/"
  },
  {
   "from": "^/submit/white-rabbit/?$",
   "to": "https://whiterabbitreview.com/",
   "final": true
  },
  {
   "from": "^/white-rabbit(/.*)?$",
   "to": "https://whiterabbitreview.com/",
   "final": true
  },
  {
   "from": "^/(?:tag/podcast|podcast|life-on-words)(/.*)?$",
   "to": "https://lifeonwords.com/",
   "final": true
  },
  {
   "from": "^/by/(?:podcast|life-on-words|digest)/?$",
   "to": "https://lifeonwords.com/",
   "final": true
  },
  {
   "from": "^/review(/.*)?$",
   "to": "https://inkhornreview.com/review$1",
   "final": true
  },
  {
   "from": "^/(poetry|fiction|nonfiction|art|micro)(/.*)?$",
   "to": "https://inkhornreview.com/$1$2",
   "final": true
  },
  {
   "from": "^/(submissions|readers)/?$",
   "to": "https://inkhornreview.com/$1/",
   "final": true
  },
  {
   "from": "^/rss/?$",
   "to": "https://inkhornreview.com/review/feed/",
   "final": true
  },
  {
   "from": "^/founder-letter(/.*)?$",
   "to": "https://inkhornreview.com/review/founder-letter/",
   "final": true
  },
  {
   "from": "^/september-2026(/.*)?$",
   "to": "https://inkhornreview.com/review/autumn-2026/",
   "final": true
  }
 ]
}