{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "34rem",
      "wideSize": "70rem"
    },
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ground",
          "color": "#FBFAF7",
          "name": "Ground"
        },
        {
          "slug": "ink",
          "color": "#2C2A26",
          "name": "Ink"
        },
        {
          "slug": "mute",
          "color": "#67645D",
          "name": "Muted"
        },
        {
          "slug": "accent",
          "color": "#4F5B66",
          "name": "Accent (set per site)"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "garamond",
          "name": "EB Garamond",
          "fontFamily": "'EB Garamond', Georgia, serif"
        },
        {
          "slug": "karla",
          "name": "Karla",
          "fontFamily": "'Karla', system-ui, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--ground)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--garamond)",
      "fontSize": "19px",
      "lineHeight": "1.55"
    },
    "spacing": {
      "blockGap": "0"
    }
  },
  "templateParts": [
    {
      "name": "header-hub",
      "title": "Header: hub",
      "area": "header"
    },
    {
      "name": "header-review",
      "title": "Header: review",
      "area": "header"
    },
    {
      "name": "header-whiterabbit",
      "title": "Header: whiterabbit",
      "area": "header"
    },
    {
      "name": "header-terryheath",
      "title": "Header: terryheath",
      "area": "header"
    },
    {
      "name": "header-lifeonwords",
      "title": "Header: lifeonwords",
      "area": "header"
    },
    {
      "name": "footer-hub",
      "title": "Footer: hub",
      "area": "footer"
    },
    {
      "name": "footer-review",
      "title": "Footer: review",
      "area": "footer"
    },
    {
      "name": "footer-whiterabbit",
      "title": "Footer: whiterabbit",
      "area": "footer"
    },
    {
      "name": "footer-terryheath",
      "title": "Footer: terryheath",
      "area": "footer"
