{{!< default}}
<main class="site-main">
    <div class="error-page gh-canvas">
        <p class="gh-error-code">{{statusCode}}</p>
        <h1>Page not found</h1>
        <p>That page doesn't exist or has moved. Try the home page, the podcast, or search.</p>
        <p>
            <a class="button" href="{{@site.url}}">Go to the home page</a>
            <a class="button button-secondary" href="{{@site.url}}/podcast/">Life on Words Podcast</a>
            <button class="button button-secondary" data-ghost-search>Search the site</button>
        </p>
        <p>Still stuck? Write to <a href="mailto:hello@terryheath.com">hello@terryheath.com</a>.</p>
    </div>
</main>
