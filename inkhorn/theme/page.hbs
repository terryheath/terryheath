{{!< default}}

{{#post}}
{{#has tag="#catalog"}}
  {{!-- Page is tagged #catalog: use book page layout --}}
  {{> "book-page"}}
{{else}}
  {{!-- Secondary check: loop all tags (including internal) and match slug hash-catalog --}}
  {{#foreach tags visibility="all"}}{{#match slug "hash-catalog"}}{{> "book-page"}}{{/match}}{{/foreach}}
  {{!-- Default page layout --}}
  <main class="site-main">
    {{> "content" width="wide"}}
  </main>
{{/has}}
{{/post}}
