{{!< default}}

{{!--
  tag.hbs — Season collections, publication tag pages, genre/dept routes,
  contributor and theme tag pages.

  Ghost 5: posts are at ROOT LEVEL, not inside {{#tag}}.
  {{#tag}} provides tag metadata only. Use it for headers.
  Use {{#foreach posts}} at root for posts.

  Publication tags (inkhorn-N, whiterabbit-N, anthology-N, awards-N):
    Header + post list use the contributor/theme layout.
    A link to the matching catalog/issue page is injected above the post list
    by the footer injection script.

  Contributor detection in post cards:
    ih-tag-post-issue / ih-card-light-label shows the first publication tag
    name found on the post, if any. Replaces the old season-name display.
--}}

<main class="site-main">

{{!-- ── HEADER: inside {{#tag}} to access tag metadata ────────────────────── --}}
{{#tag}}

{{#match slug "~^" "autumn-"}}
    <section class="ih-season-page">
        {{#if feature_image}}
        <div class="ih-season-cover">
            <img src="{{img_url feature_image size="l"}}" alt="{{name}} cover">
        </div>
        {{/if}}
        <div class="ih-season-header">
            <h1 class="ih-season-heading">{{name}}</h1>
            {{#if description}}<p class="ih-season-desc">{{description}}</p>{{/if}}
        </div>
    </section>
    <div id="ih-season-art-target"></div>
    <script>(function(){var s=document.getElementById('ih-season-art'),t=document.getElementById('ih-season-art-target');if(s&&t)t.innerHTML=s.innerHTML;})();</script>
{{/match}}

