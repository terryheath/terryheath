{{/match}}

{{!-- Contributor / theme / publication tag header
     (all non-season, non-genre slugs including inkhorn-N etc.) --}}
{{#match slug "~^" "autumn-"}}{{else}}
{{#match slug "~^" "winter-"}}{{else}}
{{#match slug "~^" "spring-"}}{{else}}
{{#match slug "~^" "summer-"}}{{else}}
{{#match slug "=" "poetry"}}{{else}}
{{#match slug "=" "fiction"}}{{else}}
{{#match slug "=" "nonfiction"}}{{else}}
{{#match slug "=" "micro"}}{{else}}
{{#match slug "=" "art"}}{{else}}
{{#match slug "=" "podcast"}}{{else}}
{{#match slug "=" "letter"}}{{else}}
    {{#if codeinjection_head}}
    <div class="ih-shelf-wrapper">
        <div id="ih-shelf-target-{{slug}}"></div>
    </div>
    <script>(function(){var s=document.getElementById('ih-shelf-{{slug}}'),t=document.getElementById('ih-shelf-target-{{slug}}');if(s&&t)t.innerHTML=s.innerHTML;})();</script>
    {{/if}}
    <section class="ih-tag-page">
        {{#if feature_image}}
        <div class="ih-tag-cover">
            <img src="{{img_url feature_image size="l"}}" alt="{{name}} cover">
        </div>
        {{/if}}
        <div class="ih-tag-page-header">
            <h1 class="ih-tag-page-name">{{name}}</h1>
            {{#if description}}<p class="ih-tag-page-desc">{{description}}</p>{{/if}}
        </div>
    </section>
    {{!-- For publication tag pages (inkhorn-N, etc.): link to the matching
         catalog/issue page, server-side via {{#get}}. --}}
    {{#match slug "~^" "inkhorn-"}}
        {{#get "pages" filter="tag:{{slug}}" limit="1" include="tags"}}
        {{#foreach pages}}<div class="ih-pub-tag-page-link"><a href="{{url}}">{{title}}</a>{{#foreach tags}}{{#match slug "=" "hash-catalog"}}&ensp;&mdash;&ensp;<a href="{{../url}}">buy the print edition &rarr;</a>{{/match}}{{/foreach}}</div>{{/foreach}}
        {{/get}}
    {{/match}}
    {{#match slug "~^" "whiterabbit-"}}
        {{#get "pages" filter="tag:{{slug}}" limit="1" include="tags"}}
        {{#foreach pages}}<div class="ih-pub-tag-page-link"><a href="{{url}}">{{title}}</a>{{#foreach tags}}{{#match slug "=" "hash-catalog"}}&ensp;&mdash;&ensp;<a href="{{../url}}">buy the print edition &rarr;</a>{{/match}}{{/foreach}}</div>{{/foreach}}
        {{/get}}
    {{/match}}
    {{#match slug "~^" "anthology-"}}
        {{#get "pages" filter="tag:{{slug}}" limit="1" include="tags"}}
        {{#foreach pages}}<div class="ih-pub-tag-page-link"><a href="{{url}}">{{title}}</a>{{#foreach tags}}{{#match slug "=" "hash-catalog"}}&ensp;&mdash;&ensp;<a href="{{../url}}">buy the print edition &rarr;</a>{{/match}}{{/foreach}}</div>{{/foreach}}
        {{/get}}
    {{/match}}
    {{#match slug "~^" "awards-"}}
        {{#get "pages" filter="tag:{{slug}}" limit="1" include="tags"}}
        {{#foreach pages}}<div class="ih-pub-tag-page-link"><a href="{{url}}">{{title}}</a>{{#foreach tags}}{{#match slug "=" "hash-catalog"}}&ensp;&mdash;&ensp;<a href="{{../url}}">buy the print edition &rarr;</a>{{/match}}{{/foreach}}</div>{{/foreach}}
        {{/get}}
    {{/match}}
{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}{{/match}}

{{/tag}}

{{!-- ── POSTS: at root level (Ghost 5: posts are NOT inside {{#tag}}) ──────── --}}

{{!-- Season collection post lists --}}
{{#match slug "~^" "autumn-"}}
<div class="ih-season-posts">
    {{#foreach posts}}
    <a href="{{url}}" class="ih-card-light">
        <div class="ih-card-light-label">
            {{#foreach tags}}{{#match slug "=" "micro"}}Micro{{/match}}{{#match slug "=" "poetry"}}Poetry{{/match}}{{#match slug "=" "fiction"}}Fiction{{/match}}{{#match slug "=" "nonfiction"}}Nonfiction{{/match}}{{#match slug "=" "art"}}Art{{/match}}{{/foreach}}
        </div>
        <div class="ih-card-light-title">{{title}}</div>
        {{#if custom_excerpt}}<div class="ih-card-light-author">{{custom_excerpt}}</div>{{/if}}
    </a>
    {{/foreach}}
</div>
{{#if pagination}}{{pagination}}{{/if}}
{{/match}}

