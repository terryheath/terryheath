{{!< default}}
{{!--
  tag.hbs — /by/<slug>/ . One page per contributor, across every publication.
  Sections show only where the person has work: Inkhorn Review, White Rabbit.
  Topic tags (grief, animals, ...) use the same page with a plain "Work about" heading.
  Season tags are redirected to /review/<issue>/ and never linked.
--}}
<main class="ip-page">
{{#tag}}
<nav class="ip-crumbs" aria-label="Breadcrumb"><a href="/">Inkhorn Press</a> &rsaquo; {{#has slug="grief,guilt,animals,fathers,mothers,aging,the-body,solitude,class,memory,watching,childhood,marriage,catastrophe,freedom,sexuality,family,religion"}}Topics{{else}}Contributors{{/has}} &rsaquo; {{name}}</nav>
<section class="ip-sec ip-contrib" style="border:0">
  <aside>
    {{#if feature_image}}<img src="{{img_url feature_image size="s"}}" alt="" width="200" style="max-width:100%;height:auto;margin-bottom:16px">{{/if}}
    <h1 class="ip-h1" style="font-size:48px">{{name}}</h1>
    <p style="font:14px var(--ip-sans);color:var(--ip-muted)">inkhorn.press/by/{{slug}}</p>
    {{#if description}}<p style="font-size:19px;line-height:1.5">{{description}}</p>{{/if}}
    {{#if canonical_url}}<p><a href="{{canonical_url}}" rel="noopener">{{canonical_url}}</a></p>{{/if}}
  </aside>
  <div>
    {{#get "posts" filter="tag:{{slug}}+tag:-white-rabbit+tag:-hash-import-2026-08-31-04-41" limit="100" include="tags" order="published_at desc"}}{{#if posts}}
    <section aria-labelledby="c-ir"><h2 id="c-ir">In Inkhorn Review</h2>
      {{#foreach posts}}<a class="work" href="{{url}}"><span style="font-size:22px">{{title}}</span><span style="font:14px var(--ip-sans);color:var(--ip-muted)">{{primary_tag.name}} &middot; {{date format="MMMM YYYY"}}</span></a>{{/foreach}}
    </section>{{/if}}{{/get}}
    {{#get "posts" filter="tag:{{slug}}+tag:white-rabbit" limit="100" order="published_at desc"}}{{#if posts}}
    <section aria-labelledby="c-wr"><h2 id="c-wr">In White Rabbit</h2>
      {{#foreach posts}}<a class="work" href="{{url}}"><span style="font-size:22px">{{title}}</span><span style="font:14px var(--ip-sans);color:var(--ip-muted)">{{date format="MMMM D, YYYY"}}</span></a>{{/foreach}}
    </section>{{/if}}{{/get}}
  </div>
</section>
{{/tag}}
</main>
