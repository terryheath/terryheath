{{!< default}}
{{!-- submit.hbs — /submit/: one card per publication, live status from main.js --}}
<main class="ip-page">
<section class="ip-sec" style="border:0;padding-bottom:24px"><h1 class="ip-h1">Submit your work</h1>
<p class="ip-lede">Each publication reads separately. Choose where your work belongs; each button opens that journal&rsquo;s call.</p></section>
<section class="ip-sec ip-grid" style="border:0;padding-top:0;grid-template-columns:repeat(auto-fit,minmax(320px,1fr))">
<article class="ip-submit-card" aria-labelledby="s-ir">
  <div><span class="ip-badge" data-ip-status="readingbadge">Paid call open all year</span></div>
  <h2 id="s-ir">Inkhorn Review</h2>
  <p>Poetry, especially in form; fiction; nonfiction; art.</p>
  <ul><li>Free reading periods every Feb, May, Aug and Nov: up to 3 poems, 1 flash or 1 prose piece</li><li>Paid call open all year: $5, refunded once you sign a contributor agreement</li><li>Art: traditional media only, no photography or digital art</li></ul>
  <a class="go" href="/submit/review">Submit to Inkhorn Review</a><span class="url">inkhorn.press/submit/review</span>
</article>
<article class="ip-submit-card dark" aria-labelledby="s-wr">
  <div><span class="ip-badge off">Details coming soon</span></div>
  <h2 id="s-wr">White Rabbit</h2>
  <p>Weird poetry, short prose and art, for Issue No. 1 on Friday, August 13, 2027.</p>
  <ul><li>Details coming soon.</li></ul>
  <a class="go alt" href="/white-rabbit/#wr-mail">Remind me when it opens</a><span class="url">inkhorn.press/submit/white-rabbit</span>
</article>
<article class="ip-submit-card" aria-labelledby="s-mu">
  <div><span class="ip-badge">Always open</span></div>
  <h2 id="s-mu">Muse</h2>
  <p>Post a poem or short prose, and readers decide what gets published each season.</p>
  <ul><li>Issues January 1, April 1, July 1 and October 1</li><li>Free to post</li></ul>
  <a class="go alt" href="/submit/muse">Post on Muse &#8599;</a><span class="url">inkhorn.press/submit/muse &rarr; gomuse.io</span>
</article>
</section></main>
