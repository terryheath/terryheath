{{#get "posts" limit="4" filter="primary_tag:{{primary_tag.slug}}+id:-{{id}}" as |related|}}
{{#if related}}
    <section class="related-wrapper">
        {{!-- primary_tag is empty inside this {{#get}} block, so read the post from the page root --}}
        <h3 class="related-title">{{#if @root.post.primary_tag.name}}More from {{@root.post.primary_tag.name}}{{else}}More to read{{/if}}</h3>
        <div class="related-feed">
            {{#foreach related}}
                {{> "loop"}}
            {{/foreach}}
        </div>
    </section>
{{/if}}
{{/get}}
