{{!-- Only members-only posts (old email digests) reach this; every piece is public. --}}
{{#unless access}}
<section class="single-cta">
    <h2 class="single-cta-title">{{t "This post is for newsletter members"}}</h2>
    {{#unless @member}}
        <button class="button single-cta-button" data-portal="signup">{{t "Sign up free"}}</button>
        <br>
        <button class="button-text single-cta-footer" data-portal="signin">{{t "Already have an account?"}} {{t "Sign in"}}</button>
    {{/unless}}
</section>
{{/unless}}
