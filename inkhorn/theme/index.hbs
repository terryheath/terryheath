{{!< default}}

{{!--
  index.hbs — The Archive at /archive/
  Each entry: label (Free / Subscribers · genre linked to genre page), title
  (stretched link), contributor (custom_excerpt), date. Posts grouped under
  month-and-year headings by a small inline script. No network requests.
--}}

<main class="site-main">
<div class="ih-archive-page">

    <div class="ih-archive-page-header">
        <h1 class="ih-archive-page-heading">The Archive</h1>
    </div>
    {{> "genre-filter-row"}}

    <div class="ih-archive-post-list" id="ih-archive-list">
        {{#foreach posts}}
        <div class="ih-archive-entry"
             data-month="{{date published_at format="YYYY-MM"}}"
             data-month-name="{{date published_at format="MMMM YYYY"}}">
            <div class="ih-archive-entry-label">
                {{#match visibility "=" "public"}}Free{{else}}Subscribers{{/match}}{{#has tag="micro"}} &middot; <a href="/micro/" class="ih-archive-genre-link">Micro</a>{{else}}{{#has tag="poetry"}} &middot; <a href="/poetry/" class="ih-archive-genre-link">Poetry</a>{{else}}{{#has tag="fiction"}} &middot; <a href="/fiction/" class="ih-archive-genre-link">Fiction</a>{{else}}{{#has tag="nonfiction"}} &middot; <a href="/nonfiction/" class="ih-archive-genre-link">Nonfiction</a>{{else}}{{#has tag="art"}} &middot; <a href="/art/" class="ih-archive-genre-link">Art</a>{{else}}{{#has tag="letter"}} &middot; Letter{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}{{/has}}
            </div>
            <div class="ih-archive-entry-title"><a href="{{url}}" class="ih-archive-entry-link">{{title}}</a></div>
            {{#if custom_excerpt}}<div class="ih-archive-entry-author">{{custom_excerpt}}</div>{{/if}}
            <div class="ih-archive-entry-date">{{date published_at format="D MMM YYYY"}}</div>
        </div>
        {{/foreach}}
    </div>

    {{pagination}}

</div>
</main>

{{!-- Month-year heading injector: groups archive items under "October 2026"
     style headings by reading data-month / data-month-name from each entry.
     DOM-only, no network request. --}}
<script>
(function(){
    var list = document.getElementById('ih-archive-list');
    if (!list) return;
    var items = list.querySelectorAll('.ih-archive-entry');
    var lastMonth = null;
    items.forEach(function(item) {
        var month = item.getAttribute('data-month');
        var monthName = item.getAttribute('data-month-name');
        if (month && month !== lastMonth) {
            var heading = document.createElement('div');
            heading.className = 'ih-season-heading';
            heading.textContent = monthName || month;
            list.insertBefore(heading, item);
            lastMonth = month;
        }
    });
})();
</script>
