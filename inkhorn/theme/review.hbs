{{!< default}}
{{!-- review.hbs — /review/ (index of the /review/ collection) --}}
<main class="ip-page">
<section class="ip-sec"><p class="ip-eyebrow">Quarterly journal</p><h1 class="ip-h1">Inkhorn Review</h1>
<p class="ip-lede">A quarterly of poetry, short prose and art. Free to read online.</p>
<nav class="ip-btns" aria-label="Departments"><a class="ip-btn alt" href="/poetry/">Poetry</a><a class="ip-btn alt" href="/fiction/">Fiction</a><a class="ip-btn alt" href="/nonfiction/">Nonfiction</a><a class="ip-btn alt" href="/art/">Art</a><a class="ip-btn alt" href="/review/founder-letter/">Founder&rsquo;s Letter</a><a class="ip-btn alt" href="/review/issues/">Issues</a></nav></section>

{{#get "pages" filter="tag:hash-catalog+featured:true" order="published_at desc" include="tags" limit="1"}}{{#foreach pages}}
<section class="ip-sec ip-hero">
  {{#if feature_image}}<a class="ip-cover" href="{{url}}"><img src="{{img_url feature_image size="l"}}" alt="{{title}} cover" width="480" height="690"></a>{{/if}}
  <div><p class="ip-eyebrow">Current issue</p><h2 class="ip-h1" style="font-size:48px">{{title}}</h2>
  {{#if custom_excerpt}}<p class="ip-lede">{{custom_excerpt}}</p>{{/if}}
  <div class="ip-btns"><a class="ip-btn" href="{{url}}">Full contents</a></div></div>
</section>
{{/foreach}}{{/get}}

<section class="ip-sec" aria-labelledby="subs"><h2 class="ip-h2" id="subs">Subscribe to Inkhorn Review</h2>
<div class="ip-grid">
  <a class="ip-card" href="#/portal/signup/free"><span class="k">Weekly email</span><span class="t">Free</span><span class="d">One piece every Sunday.</span></a>
  <a class="ip-card" href="#/portal/signup"><span class="k">Ebook</span><span class="t">$20 a year</span><span class="d">Four issues.</span></a>
  <a class="ip-card" href="#/portal/signup"><span class="k">Print</span><span class="t">$48 a year</span><span class="d">Four print issues.</span></a>
</div></section>

<section class="ip-sec" aria-labelledby="past"><h2 class="ip-h2" id="past">Latest pieces</h2>
<div class="ip-rows">{{#foreach posts limit="12"}}<a href="{{url}}"><span class="what">{{title}}</span><span class="sub">{{primary_tag.name}}{{#if primary_author}}{{/if}}</span></a>{{/foreach}}</div>
{{pagination}}</section>
</main>
