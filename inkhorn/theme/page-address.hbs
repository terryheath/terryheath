{{!< default}}

{{!--
  page-address.hbs — Shipping address form for Print members.
  Ghost page slug: address  (URL: /address/)

  Only Print members see the form. Non-members and non-Print members
  see a message explaining access. The form POSTs to the address service
  at https://address.inkhornreview.com via address-form.js.
--}}

<main class="site-main">
<div class="ih-address-page">

    {{#if @member}}
        <div class="ih-address-form-wrap" id="ih-address-form-wrap">
            <h1 class="ih-address-page-title">Mailing Address</h1>
            <p class="ih-address-page-desc" id="ih-address-page-desc">
                Enter the address where you'd like to receive your print issues.
                U.S. addresses only.
            </p>

            <form class="ih-address-form" id="ih-address-form" novalidate>
                <div class="ih-address-field">
                    <label for="ih-addr-name">Full name</label>
                    <input type="text" id="ih-addr-name" name="name" autocomplete="name" required>
                </div>
                <div class="ih-address-field">
                    <label for="ih-addr-addr1">Address</label>
                    <input type="text" id="ih-addr-addr1" name="addr1" autocomplete="address-line1" required>
                </div>
                <div class="ih-address-field">
                    <label for="ih-addr-addr2">Apt / Suite <span class="ih-address-optional">(optional)</span></label>
                    <input type="text" id="ih-addr-addr2" name="addr2" autocomplete="address-line2">
                </div>
                <div class="ih-address-field-row">
                    <div class="ih-address-field">
                        <label for="ih-addr-city">City</label>
                        <input type="text" id="ih-addr-city" name="city" autocomplete="address-level2" required>
                    </div>
                    <div class="ih-address-field ih-address-field--state">
                        <label for="ih-addr-state">State</label>
                        <input type="text" id="ih-addr-state" name="state" autocomplete="address-level1" maxlength="2" required>
                    </div>
                    <div class="ih-address-field">
                        <label for="ih-addr-zip">ZIP</label>
                        <input type="text" id="ih-addr-zip" name="zip" autocomplete="postal-code" inputmode="numeric" maxlength="10" required>
                    </div>
                </div>
                <div class="ih-address-error" id="ih-address-error" style="display:none"></div>
                <button type="submit" class="ih-address-submit" id="ih-address-submit">Save address</button>
            </form>

            <div class="ih-address-success" id="ih-address-success" style="display:none">
                <p>&#x2713; Your address has been saved.</p>
            </div>
        </div>
    {{else}}
        <div class="ih-address-page-gate">
            <h1 class="ih-address-page-title">Mailing Address</h1>
            <p>This page is for Print subscribers. <a href="#/portal/signin" data-portal="signin">Sign in</a> to add or update your address.</p>
        </div>
    {{/if}}

</div>
</main>
