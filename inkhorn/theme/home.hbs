{{!< default}}
{{!-- home.hbs — Inkhorn Press home (theme 1.4.0). Status strip dates are computed in main.js. --}}
<main class="ip-page">
<section class="ip-strip" aria-label="Now"><div class="ip-wrap">
  <span><b>NOW</b><span data-ip-status="now">Free reading period</span></span>
  <span><b>NEXT</b><a href="/review/issues/" data-ip-status="next">Inkhorn Review</a></span>
  <span><b>FRIDAY THE 13TH</b><span data-ip-status="f13">August 13, 2027</span></span>
</div></section>

{{#get "pages" filter="tag:hash-catalog+featured:true" order="published_at desc" limit="1"}}{{#foreach pages}}
<section class="ip-sec ip-hero">
  <div>
    <p class="ip-eyebrow">Inkhorn Review &middot; {{title}}</p>
    <h1 class="ip-h1">Free to read online. In print four times a year.</h1>
    <p class="ip-lede">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}Poetry, short fiction, nonfiction and art.{{/if}}</p>
    <div class="ip-btns"><a class="ip-btn" href="/review/">Read the Review</a><a class="ip-btn alt" href="/review/autumn-2026/">Read Autumn 2026</a></div>
  </div>
  {{#if feature_image}}<a class="ip-cover" href="{{url}}"><img src="{{img_url feature_image size="l"}}" alt="{{title}} cover" width="480" height="690"></a>{{/if}}
</section>
{{/foreach}}{{/get}}

<section class="ip-sec" aria-labelledby="pubs"><h2 class="ip-h2" id="pubs">From the press</h2>
<div class="ip-grid">
  <a class="ip-card" href="/review/"><span class="k">Quarterly journal</span><span class="t">Inkhorn Review</span><span class="d">Poetry, short prose and art. New issues March, June, September and December 1.</span></a>
  <a class="ip-card dark" href="/white-rabbit/"><span class="k">Friday the 13th only</span><span class="t">White Rabbit</span><span class="d">Weird poetry, prose and art. Issue No. 1: August 13, 2027.</span></a>
  <a class="ip-card" href="https://gomuse.io"><span class="k">Crowdsourced &middot; app &#8599;</span><span class="t">Muse</span><span class="d">Readers choose the poems. A new issue every season, on gomuse.io.</span></a>
</div></section>

<section class="ip-sec" id="events" aria-labelledby="ev">
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline"><h2 class="ip-h2" id="ev">Events</h2><a href="/events/" style="font:15px var(--ip-sans)">All events</a></div>
<div class="ip-rows">
  <a href="/weird-friday/"><span class="when">Fri, Aug 13, 2027</span><span class="what">Weird Friday</span><span class="sub">Details coming soon.</span></a>
  <a href="/bookfolk/"><span class="when">Jul 17&ndash;18, 2027</span><span class="what">BookFolk</span><span class="sub">Quincy Square, Bremerton, WA</span></a>
</div></section>

<section class="ip-sec" id="newsletters" aria-labelledby="nl">
<h2 class="ip-h2" id="nl">Choose what lands in your inbox</h2>
<p class="ip-lede" style="margin:0 0 20px">Free. Pick any or all, and change them anytime.</p>
{{> "newsletter-form" id="home"}}
</section>

<section class="ip-sec" id="support" aria-labelledby="sp">
<h2 class="ip-h2" id="sp">Support the press</h2>
<p class="ip-lede" style="margin:0 0 20px">Inkhorn Press is a nonprofit. Your gift pays contributors and keeps every journal free to read online.</p>
<a class="ip-btn" href="/support/">Give to Inkhorn Press</a>
</section>
</main>
